\@writefile{toc}{\contentsline {paragraph}{The loss plays a major role.}{8}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Spectra of $MA$ on a representative multiphase Poisson frame at $N{=}1024$. Top: unpreconditioned vs.\ Jacobi. Bottom: same architecture trained with SAI loss (16$\times $ reduction, cluster anchored near $\|A\|$) vs.\ cosine-Hutchinson (68$\times $ reduction, cluster wherever angular alignment is easiest). The 4.3$\times $ quality gap is attributable to the loss alone.}}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:spectra}{{3}{9}{Spectra of $MA$ on a representative multiphase Poisson frame at $N{=}1024$. Top: unpreconditioned vs.\ Jacobi. Bottom: same architecture trained with SAI loss (16$\times $ reduction, cluster anchored near $\|A\|$) vs.\ cosine-Hutchinson (68$\times $ reduction, cluster wherever angular alignment is easiest). The 4.3$\times $ quality gap is attributable to the loss alone}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Probe-objective alignment, not Frobenius distance, predicts PCG quality.}{9}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Training profile at $N{=}8192$. Blue: cosine-Hutchinson loss falls; orange: PCG iterations on a held-out frame fall in lockstep. Green dashed: SAI loss on the same checkpoints --- keeps falling while PCG iteration count has bottomed out and started to climb. Direct evidence that the loss the network is minimizing has to measure what CG cares about.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:training}{{4}{10}{Training profile at $N{=}8192$. Blue: cosine-Hutchinson loss falls; orange: PCG iterations on a held-out frame fall in lockstep. Green dashed: SAI loss on the same checkpoints --- keeps falling while PCG iteration count has bottomed out and started to climb. Direct evidence that the loss the network is minimizing has to measure what CG cares about}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Why a learned $M$ moves error globally where IC/Jacobi cannot}{10}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Multiscale error transport across preconditioner families on a challenging multiphase Poisson frame (closed cross-barrier topology, stiff density contrast). Top row: density $\rho $, RHS $b$, pressure $p$, $|v|$, and a top-left view of the learned $M$. Rows below: unpreconditioned CG, Jacobi, IC, AMG, and the hierarchical transformer. Each row shows $|r_k|$ on a shared log color scale at five iteration snapshots; row labels give iteration count to rtol=$10^{-8}$. At $k=1$, Jacobi and IC damp error only locally around $\mathrm  {supp}(b)$; AMG and the learned $M$ have already attenuated the residual across the whole domain --- direct evidence that the learned $M$ routes correction signals across graph-distant regions in a single apply.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:convergence}{{5}{11}{Multiscale error transport across preconditioner families on a challenging multiphase Poisson frame (closed cross-barrier topology, stiff density contrast). Top row: density $\rho $, RHS $b$, pressure $p$, $|v|$, and a top-left view of the learned $M$. Rows below: unpreconditioned CG, Jacobi, IC, AMG, and the hierarchical transformer. Each row shows $|r_k|$ on a shared log color scale at five iteration snapshots; row labels give iteration count to rtol=$10^{-8}$. At $k=1$, Jacobi and IC damp error only locally around $\mathrm {supp}(b)$; AMG and the learned $M$ have already attenuated the residual across the whole domain --- direct evidence that the learned $M$ routes correction signals across graph-distant regions in a single apply}{figure.caption.5}{}}
